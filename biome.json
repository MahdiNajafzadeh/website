{
    "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
    "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!src/payload-types.ts", "!**/*.bak"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always"
        }
    },
    "css": { "parser": { "tailwindDirectives": true } }
}
