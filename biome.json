{
    "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
    "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": [
            "**",
            "!node_modules",
            "!.next",
            "!dist",
            "!build",
            "!src/payload-types.ts",
            "!**/*.bak"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always"
        }
    },
    "css": {
        "formatter": { "enabled": true }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "suspicious": {
                "noExplicitAny": "warn"
            },
            "style": {
                "noNonNullAssertion": "warn"
            }
        }
    }
}
