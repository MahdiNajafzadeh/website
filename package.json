{
    "name": "website",
    "version": "1.0.0",
    "description": "A blank template to get started with Payload 3.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
        "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
        "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
        "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
        "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
        "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
        "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/seed.ts",
        "seed:reset": "rm -f website.db media/ && echo 'Local DB and media cleared. Run pnpm seed to re-populate.'",
        "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
        "test": "pnpm run test:int && pnpm run test:e2e",
        "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
        "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@payloadcms/db-sqlite": "3.87.1",
        "@payloadcms/next": "3.87.1",
        "@payloadcms/richtext-lexical": "3.87.1",
        "@payloadcms/ui": "3.87.1",
        "@tailwindcss/postcss": "^4.3.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cross-env": "^10.1.0",
        "dotenv": "17.4.2",
        "graphql": "^17.0.2",
        "lucide-react": "^1.30.0",
        "next": "16.3.0",
        "payload": "3.87.1",
        "postcss": "^8.5.26",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "shadcn": "^4.16.2",
        "sharp": "0.35.3",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "tailwindcss": "^4.3.3",
        "@playwright/test": "1.62.1",
        "@testing-library/react": "16.3.2",
        "@types/node": "26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "eslint": "^10.8.1",
        "eslint-config-next": "16.3.0",
        "jsdom": "30.0.1",
        "prettier": "^3.9.6",
        "tsx": "4.23.11",
        "typescript": "7.0.2",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.10"
    },
    "engines": {
        "node": "^18.20.2 || >=20.9.0",
        "pnpm": "^9 || ^10 || ^11"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "sharp",
            "esbuild",
            "unrs-resolver"
        ]
    },
    "trustedDependencies": [
        "unrs-resolver"
    ]
}
