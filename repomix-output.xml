              {/* Auth links — {typography.button-sm} 14px/500, pill variants */}
              <Link
                href="/login"
                // {typography.caption-md} 14px/500/1.5, {colors.mute} #707072 hover {colors.ink} #111111 on mobile, auth pill on desktop
