                      >
                        <Minus className="h-3.5 w-3.5" />
                      </Button>
                      <span className="w-8 text-center text-[14px] font-medium text-[#111111]">{item.quantity}</span>
                      <Button
                        variant="outline"
                        size="icon-sm"
                        aria-label={`Increase quantity for ${item.name}`}
