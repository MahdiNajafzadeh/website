.dark {
  --background: oklch(0.145 0 0);
  --foreground: oklch(0.985 0 0);
  --card: oklch(0.205 0 0);
  --card-foreground: oklch(0.985 0 0);
  --popover: oklch(0.205 0 0);
  --popover-foreground: oklch(0.985 0 0);
  --primary: oklch(0.922 0 0);
  --primary-foreground: oklch(0.205 0 0);
  --secondary: oklch(0.269 0 0);
  --secondary-foreground: oklch(0.985 0 0);
  --muted: oklch(0.269 0 0);
  --muted-foreground: oklch(0.708 0 0);
  --accent: oklch(0.269 0 0);
  --accent-foreground: oklch(0.985 0 0);
  --destructive: oklch(0.704 0.191 22.216);
  --destructive-foreground: 0 0% 100%;
  --border: oklch(1 0 0 / 10%);
  --input: oklch(1 0 0 / 15%);
  --ring: oklch(0.556 0 0);
  --chart-1: oklch(0.87 0 0);
  --chart-2: oklch(0.556 0 0);
  --chart-3: oklch(0.439 0 0);
  --chart-4: oklch(0.371 0 0);
  --chart-5: oklch(0.269 0 0);
  --sidebar: oklch(0.205 0 0);
  --sidebar-foreground: oklch(0.985 0 0);
  --sidebar-primary: oklch(0.488 0.243 264.376);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.269 0 0);
  --sidebar-accent-foreground: oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.556 0 0);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
}

@layer components {
  /* ─── landing-page tokens (industrial expression of DESIGN.md) ───── */
  :root {
    --lp-bg: #ffffff;
    --lp-surface: #f5f5f5;
    --lp-fg: #111111;
    --lp-muted: #707072;
    --lp-border: #e5e5e5;
    --lp-accent: #111111;
    --lp-accent-soft: color-mix(in oklch, var(--lp-accent) 8%, transparent);
    --lp-container: 1440px;
    --lp-gutter: 32px;
  }
  :root[data-theme="dark"] {
    --lp-bg: #0e0e0e;
    --lp-surface: #1a1a1a;
    --lp-fg: #f5f5f5;
    --lp-muted: #9a9a9a;
    --lp-border: #2a2a2a;
    --lp-accent: #f5f5f5;
  }

  /* ─── container + section ─────────────────────────────────────── */
  .lp-container {
    max-width: var(--lp-container);
    margin-inline: auto;
    padding-inline: var(--lp-gutter);
  }
  @media (max-width: 640px) {
    .lp-container { padding-inline: 20px; }
  }
  .lp-section {
    padding-block: clamp(48px, 8vw, 96px);
  }
  .lp-row {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .lp-row-between {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  /* ─── grids ────────────────────────────────────────────────────── */
  .lp-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .lp-grid-4 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 1023px) {
    .lp-grid-4 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 920px) {
    .lp-grid-3 { grid-template-columns: 1fr; }
  }
  @media (max-width: 599px) {
    .lp-grid-4 { grid-template-columns: 1fr; }
  }

  /* ─── type ─────────────────────────────────────────────────────── */
  .lp-eyebrow {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lp-fg);
    font-weight: 500;
    margin: 0;
  }
  .lp-lead {
    font-size: 17px;
    line-height: 1.5;
    color: var(--lp-muted);
    max-width: 56ch;
    margin: 0;
  }
  .lp-meta {
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, monospace;
    font-size: 13px;
    color: var(--lp-muted);
  }
  .lp-num {
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, monospace;
    font-variant-numeric: tabular-nums;
  }
  .lp-h1 {
    font-size: 32px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .lp-h2 {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
  }

  /* ─── buttons (pill geometry per component.button-primary) ────── */
  .lp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 9999px;
    font-size: 15px;
    font-weight: 500;
    min-height: 48px;
    border: 1px solid transparent;
    transition: transform 0.05s ease, background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .lp-btn:active { transform: translateY(1px); }
  .lp-btn:focus-visible {
    outline: 2px solid var(--lp-accent-soft);
    outline-offset: 2px;
  }
  .lp-btn-primary {
    background: var(--lp-fg);
    color: var(--lp-bg);
  }
  .lp-btn-primary:hover { background: var(--lp-muted); }
  .lp-btn-secondary {
    background: var(--lp-bg);
    color: var(--lp-fg);
    border-color: var(--lp-border);
  }
  .lp-btn-secondary:hover { border-color: var(--lp-fg); }
  .lp-btn-ghost {
    background: transparent;
    color: var(--lp-fg);
    padding: 8px 0;
    min-height: 0;
    font-weight: 500;
  }
  .lp-btn-ghost:hover { color: var(--lp-muted); }
  .lp-btn-arrow::after {
    content: "→";
    transition: transform 0.15s ease;
  }
  .lp-btn-arrow:hover::after { transform: translateX(2px); }

  /* ─── hero ─────────────────────────────────────────────────────── */
  .lp-hero {
    padding-block: clamp(64px, 10vw, 112px);
  }
  .lp-hero-inner { max-width: 880px; }
  .lp-hero-eyebrow { color: var(--lp-fg); margin-bottom: 20px; }
  .lp-hero-title {
    font-size: clamp(36px, 5.5vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--lp-fg);
    max-width: 18ch;
    margin: 0 0 20px;
  }
  .lp-hero-sub {
    color: var(--lp-muted);
    max-width: 56ch;
    margin-bottom: 32px;
    font-size: 17px;
    line-height: 1.5;
  }
  .lp-hero-actions {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  /* ─── category navigation (page anchor) ────────────────────────── */
  .lp-categories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .lp-category-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px;
    background: var(--lp-bg);
    border: 1px solid var(--lp-border);
    border-radius: 30px;
    transition: background 0.15s ease, border-color 0.15s ease;
    min-height: 240px;
    color: inherit;
    text-decoration: none;
  }
  .lp-category-card:hover { background: var(--lp-surface); border-color: var(--lp-border); }
  .lp-category-mark {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--lp-surface);
    color: var(--lp-fg);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .lp-category-name {
    font-size: 22px;
    font-weight: 500;
    color: var(--lp-fg);
    letter-spacing: -0.005em;
    line-height: 1.3;
  }
  .lp-category-desc {
    font-size: 14px;
    color: var(--lp-muted);
    margin-top: 4px;
  }
  .lp-category-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
  }
  .lp-category-count {
    font-size: 14px;
    font-weight: 500;
    color: var(--lp-muted);
  }
  .lp-category-arrow {
    font-size: 18px;
    color: var(--lp-fg);
    transition: transform 0.15s ease;
  }
  .lp-category-card:hover .lp-category-arrow { transform: translateX(4px); }
  @media (max-width: 920px) {
    .lp-categories-grid { grid-template-columns: 1fr; }
  }

  /* ─── product card (matches /products page pattern) ────────────── */
  .lp-product {
    display: flex;
    flex-direction: column;
    background: var(--lp-bg);
    border: 1px solid var(--lp-border);
    border-radius: 30px;
    overflow: hidden;
    transition: border-color 0.15s ease;
    color: inherit;
    text-decoration: none;
  }
  .lp-product:hover { border-color: var(--lp-muted); }
  .lp-product-img {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--lp-surface);
    display: grid;
    place-items: center;
    color: var(--lp-muted);
    font-family: ui-monospace, "JetBrains Mono", "SF Mono", Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    overflow: hidden;
  }
  .lp-product-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lp-product-img .lp-ph-note {
    display: block;
    margin-top: 6px;
    text-transform: none;
    letter-spacing: 0;
    font-family: inherit;
    font-size: 12px;
    color: var(--lp-fg);
    font-weight: 400;
  }
  .lp-product-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .lp-product-cat {
    font-size: 14px;
    color: var(--lp-muted);
    font-weight: 500;
  }
  .lp-product-name {
    font-size: 16px;
    font-weight: 500;
    color: var(--lp-fg);
    line-height: 1.4;
  }
  .lp-product-price {
    font-size: 16px;
    font-weight: 500;
    color: var(--lp-fg);
    margin-top: 4px;
  }
  .lp-product-price.lp-contact {
    color: var(--lp-muted);
    font-weight: 500;
  }

  /* ─── section heads ────────────────────────────────────────────── */
  .lp-section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .lp-section-head h2 { margin-top: 6px; }
  .lp-section-eyebrow {
    color: var(--lp-fg);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ─── catalog row list (categories + brands) ───────────────────── */
  .lp-cat-list {
    display: flex;
    flex-direction: column;
  }
  .lp-cat-row {
    display: grid;
    grid-template-columns: 56px 1fr auto auto;
    gap: 20px;
    padding: 20px 8px;
    border-top: 1px solid var(--lp-border);
    align-items: center;
    transition: background 0.15s ease, padding-inline 0.15s ease;
    color: inherit;
    text-decoration: none;
  }
  .lp-cat-row:last-child { border-bottom: 1px solid var(--lp-border); }
  .lp-cat-row:hover { background: var(--lp-surface); padding-inline: 16px; }
  .lp-cat-row:focus-visible {
    outline: 2px solid var(--lp-accent-soft);
    outline-offset: -2px;
  }
  .lp-cat-mark {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--lp-surface);
    display: grid;
    place-items: center;
    font-weight: 600;
    font-size: 20px;
    color: var(--lp-fg);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }
  .lp-cat-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .lp-cat-name {
    font-size: 16px;
    font-weight: 500;
    color: var(--lp-fg);
  }
  .lp-cat-desc {
    font-size: 14px;
    color: var(--lp-muted);
  }
  .lp-cat-count {
    font-size: 14px;
    color: var(--lp-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    font-weight: 500;
  }
  .lp-cat-arrow {
    color: var(--lp-fg);
    font-size: 18px;
    transition: transform 0.15s ease;
  }
  .lp-cat-row:hover .lp-cat-arrow { transform: translateX(4px); }
  @media (max-width: 640px) {
    .lp-cat-row {
      grid-template-columns: 44px 1fr auto;
      gap: 12px;
      padding: 16px 4px;
    }
    .lp-cat-row .lp-cat-arrow { display: none; }
    .lp-cat-mark { width: 44px; height: 44px; font-size: 17px; }
  }

  /* ─── skip link ────────────────────────────────────────────────── */
  .lp-skip {
    position: absolute;
    left: -9999px;
  }
  .lp-skip:focus {
    left: 16px;
    top: 16px;
    background: var(--lp-fg);
    color: var(--lp-bg);
    padding: 10px 16px;
    border-radius: 9999px;
    z-index: 100;
  }

  /* ─── theme toggle (icon-circular per component.button-icon-circular) ── */
  .theme-toggle {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: var(--lp-surface);
    color: var(--lp-fg);
    display: grid;
    place-items: center;
    border: 0;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease, transform 0.05s ease;
  }
  .theme-toggle:hover { background: var(--lp-border); }
  .theme-toggle:active { transform: translateY(1px); }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--lp-accent-soft);
    outline-offset: 2px;
  }
  .theme-toggle svg { width: 18px; height: 18px; }
  .theme-toggle .icon-moon { display: none; }
  :root[data-theme="dark"] .theme-toggle .icon-sun { display: none; }
  :root[data-theme="dark"] .theme-toggle .icon-moon { display: block; }
}
